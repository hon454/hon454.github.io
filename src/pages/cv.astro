---
import { getEntry, render } from "astro:content";
import CareerDocumentLayout from "@/layouts/CareerDocumentLayout.astro";

const entry = await getEntry("spec", "cv");
if (!entry) throw new Error("CV page content not found");
const { Content, headings } = await render(entry);
---

<CareerDocumentLayout
	title="경력기술서"
	description="Unreal Engine 게임과 제작 도구, 실시간 VR, Rust 기반 3D 편집기 경력에서 주요 업무의 과제와 판단, 결과를 정리했습니다."
	heading="경력기술서"
	active="cv"
	headings={headings}
>
	<Content />
</CareerDocumentLayout>
