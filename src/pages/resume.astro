---
import { getEntry, render } from "astro:content";
import CareerDocumentLayout from "@/layouts/CareerDocumentLayout.astro";

const title = "이력서";
const description =
	"게임 클라이언트와 실시간 3D 제작 도구를 개발하는 클라이언트 프로그래머 전지훈의 이력서입니다. Unreal Engine과 C++, Rust와 Bevy 경력을 정리했습니다.";

const resumePost = await getEntry("spec", "resume");

if (!resumePost) {
	throw new Error("Resume page content not found");
}

const { Content, headings } = await render(resumePost);
---

<CareerDocumentLayout
	title={title}
	description={description}
	heading="이력서"
	active="resume"
	headings={headings}
>
	<Content />
</CareerDocumentLayout>
