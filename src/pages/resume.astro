---
import { getEntry, render } from "astro:content";
import CareerDocumentLayout from "@/layouts/CareerDocumentLayout.astro";

const title = "이력서";
const description =
	"Unreal Engine·C++ 게임 클라이언트부터 Rust·Bevy 기반 WebAssembly/WebGPU 런타임과 제작 도구까지, 시스템 경계를 연결해 복합 요구사항을 제품으로 완성하는 프로그래머입니다.";

const resumePost = await getEntry("spec", "resume");

if (!resumePost) {
	throw new Error("Resume page content not found");
}

const { Content, headings } = await render(resumePost);
---

<CareerDocumentLayout
	title={title}
	description={description}
	heading="이력서"
	active="resume"
	headings={headings}
>
	<Content />
</CareerDocumentLayout>
